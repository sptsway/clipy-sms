*.apk
*.aab
*.ap_
*.dex
*.class

# Generated files
bin/
gen/
out/
release/

# Instrumented test / lint / profiling
*.hprof
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Kotlin
.kotlin/
